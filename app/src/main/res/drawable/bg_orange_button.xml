<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: darker background with shadow -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow layer -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33000000"/> <!-- semi-transparent black shadow -->
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <!-- Main background layer (darker red when pressed) -->
            <item android:top="4dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#D0212D"/> <!-- darker variant of #EF2A39 -->
                    <corners android:radius="12dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Disabled state: gray background with shadow -->
    <item android:state_enabled="false">
        <layer-list>
            <!-- Shadow layer -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#22000000"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <!-- Disabled background layer -->
            <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFB0B0B0"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default state: #EF2A39 background with shadow -->
    <item>
        <layer-list>
            <!-- Shadow layer -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#22000000"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <!-- Main background layer -->
            <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#EF2A39"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>